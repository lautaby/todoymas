# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (required for the Mercado Pago webhook to update
# orders bypassing RLS). Keep this secret - never expose it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mercado Pago (required to enable the "Mercado Pago" payment option at checkout).
# These are YOUR OWN application's credentials (the developer's), not the
# client's - the client never types any Mercado Pago key anywhere. They just
# click "Conectar con Mercado Pago" in /admin/pagos and log into their own
# account; the token that results from that is stored in Supabase, not here.
#
# 1. Go to https://www.mercadopago.com.ar/developers/panel/app and create an
#    application (or use an existing one).
# 2. Under that app's "OAuth" / "Producción" credentials, copy the Client ID
#    and Client Secret below.
# 3. Under "Redirect URIs" (or "URLs de retorno"), register EXACTLY:
#      ${NEXT_PUBLIC_SITE_URL}/api/mercadopago/oauth/callback
#    (with your real domain instead of the placeholder). Must match exactly
#    what the app sends, or Mercado Pago will reject the connection.
MERCADOPAGO_CLIENT_ID=your-application-client-id
MERCADOPAGO_CLIENT_SECRET=your-application-client-secret

# Public base URL of the deployed site, used to build Mercado Pago's
# OAuth redirect_uri, back_urls and notification_url (the webhook endpoint).
# Falls back to the request's own origin if not set, but setting it
# explicitly is safer behind proxies/CDNs (Cloudflare, Netlify), and it MUST
# be set correctly for the Mercado Pago OAuth redirect_uri to match.
NEXT_PUBLIC_SITE_URL=https://todoymas.example.com

# GoCuotas (required to enable the "Cuotas sin tarjeta (GoCuotas)" payment
# option at checkout). These are the email/password of your GoCuotas
# merchant account, used to authenticate against their API (not your
# customer-facing GoCuotas login).
# For testing, GoCuotas publishes a sandbox account:
#   GOCUOTAS_EMAIL=seller_sandbox@gocuotas.com
#   GOCUOTAS_PASSWORD=secret
GOCUOTAS_EMAIL=seller_sandbox@gocuotas.com
GOCUOTAS_PASSWORD=secret
