# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (required for the Mercado Pago webhook to update
# orders bypassing RLS). Keep this secret - never expose it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mercado Pago (required to enable the "Mercado Pago" payment option at checkout).
# Get your access token from https://www.mercadopago.com.ar/developers/panel/app
# Use a TEST-... token while developing: the app auto-detects it and uses the
# sandbox checkout so you can test payments without moving real money.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxxxxxx-xxxxxxxx-xxxxxxxx

# Public base URL of the deployed site, used to build Mercado Pago's
# back_urls and notification_url (the webhook endpoint). Falls back to the
# request's own origin if not set, but setting it explicitly is safer behind
# proxies/CDNs (Cloudflare, Netlify).
NEXT_PUBLIC_SITE_URL=https://todoymas.example.com
